<% gcp_project_id = "#{external_attribute(pwd, 'gcp_project_id', doc_generation)}" -%>
<% instance_template = grab_attributes(pwd)['instance_template'] -%>
describe google_compute_instance_template(instanceTemplate: <%= doc_generation ? "' #{instance_template['instanceTemplate']}'":"instance_template['instanceTemplate']" -%>, project: <%= gcp_project_id -%>) do
	it { should exist }
	its('kind') { should cmp <%= doc_generation ? "'#{instance_template['kind']}'" : "instance_template['kind']" -%> }
	its('id') { should cmp <%= doc_generation ? "'#{instance_template['id']}'" : "instance_template['id']" -%> }
	its('creation_timestamp') { should cmp <%= doc_generation ? "'#{instance_template['creation_timestamp']}'" : "instance_template['creation_timestamp']" -%> }
	its('name') { should cmp <%= doc_generation ? "'#{instance_template['name']}'" : "instance_template['name']" -%> }
	its('description') { should cmp <%= doc_generation ? "'#{instance_template['description']}'" : "instance_template['description']" -%> }
	its('self_link') { should cmp <%= doc_generation ? "'#{instance_template['self_link']}'" : "instance_template['self_link']" -%> }
	its('self_link_with_id') { should cmp <%= doc_generation ? "'#{instance_template['self_link_with_id']}'" : "instance_template['self_link_with_id']" -%> }
	its('source_instance') { should cmp <%= doc_generation ? "'#{instance_template['source_instance']}'" : "instance_template['source_instance']" -%> }
	its('region') { should cmp <%= doc_generation ? "'#{instance_template['region']}'" : "instance_template['region']" -%> }

end

describe google_compute_instance_template(instanceTemplate: <%= doc_generation ? "' #{instance_template['instanceTemplate']}'":"instance_template['instanceTemplate']" -%>, project: <%= gcp_project_id -%>) do
	it { should_not exist }
end